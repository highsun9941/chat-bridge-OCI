# Keep the MCP listener private by default.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Only files below this directory are exposed by file tools.
WORKSPACE_ROOT=/home/ubuntu/projects/chatgptweb

MAX_READ_BYTES=1048576
MAX_WRITE_BYTES=2097152
MAX_COMMAND_OUTPUT=200000
MAX_COMMAND_TIMEOUT=600

# Optional: comma-separated environment variable names that may be inherited
# by commands launched through run_command.
CHAT_BRIDGE_EXTRA_ENV_KEYS=
