# Keep the MCP listener private.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Default working directory for relative run_command calls.
# This is not a filesystem security boundary.
AGENT_WORKDIR=/home/ubuntu/projects/chatgptweb

MAX_COMMAND_OUTPUT=200000
MAX_COMMAND_TIMEOUT=600

# Optional: comma-separated environment variable names that may be inherited
# by commands launched through run_command.
CHAT_BRIDGE_EXTRA_ENV_KEYS=
